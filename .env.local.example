# Copy to .env.local (gitignored) to make `npm run app:release` work with no
# arguments. Needed only for distributable builds — `npm run app` and
# `npm run app:build` require no signing identity.
#
# The value is the rest of the line, so the parentheses and spaces in an identity
# need no quoting or escaping. Surrounding quotes are stripped if you add them.
# Unrecognized keys warn rather than pass silently, so a typo surfaces here
# instead of arriving later as "not set".

# Find yours with: security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID1234)

# Optional. Defaults to TRMNL-notary. Create the profile once with:
#   xcrun notarytool store-credentials TRMNL-notary \
#     --apple-id "you@example.com" --team-id "TEAMID1234"
#NOTARY_PROFILE=TRMNL-notary

# Only needed if you notarize via APPLE_* env vars instead of a keychain profile.
# The profile above is preferred and makes these redundant.
#APPLE_ID=you@example.com
#APPLE_TEAM_ID=TEAMID1234

# APPLE_PASSWORD is deliberately NOT read from this file, and setting it here
# warns. It is an app-specific password that can act on your Apple account, so
# it belongs in the keychain (store-credentials, above) rather than in plaintext
# next to the source of a public repo. Export it in your shell if you must.
